PORT=3000
AUTHOR_LOGIN=rozhdestvo_v
AUTHOR_FULL_NAME=Рождественский Владислав Геннадьевич
API_TOKEN=replace_with_random_token

# Локальная PostgreSQL из compose.yaml.
# Замени пароль в обеих строках одним значением.
POSTGRES_PASSWORD=replace_with_random_hex_password
DATABASE_URL=postgresql://postgres:replace_with_random_hex_password@127.0.0.1:5433/node_todo
DB_SSL=false

# Для облачной PostgreSQL замени активный DATABASE_URL выше
# и установи DB_SSL=true. Не оставляй два активных DATABASE_URL.
# DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/postgres
# DB_SSL_CA_PATH=./certs/supabase-ca.crt

# На Vercel вместо DB_SSL_CA_PATH используется CA в Base64.
# DB_SSL_CA_BASE64=replace_with_base64_encoded_ca
